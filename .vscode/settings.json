{
  // Associate Helm template files with "plaintext" so VS Code's YAML language
  // server never tries to parse them. Helm's {{ }} syntax is not valid YAML and
  // will always produce false-positive errors in any YAML linter.
  // Note: this disables syntax highlighting for template files. If you want
  // highlighting, install the "Helm Intellisense" extension (Tim-Koehler.helm-intellisense)
  // and change these associations to "helm".
  "files.associations": {
    "**/templates/*.yaml": "plaintext",
    "**/templates/*.yml": "plaintext"
  },

  // Schema mappings for non-template YAML files:
  //   Chart.yaml  → Helm chart schema from SchemaStore
  //   values.yaml → no schema assigned (pure Helm values, no standard schema applies)
  "yaml.schemas": {
    "https://json.schemastore.org/chart.json": [
      "**/Chart.yaml",
      "**/Chart.yml"
    ]
  }
}
