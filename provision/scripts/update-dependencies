#!/bin/bash

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
LOG_FILE="$PROJECT_DIR/provision.log"

source "$(dirname "$SCRIPT_DIR")/lib/defaults.sh"
require_server_ip

SSH_TIMEOUT=5

PACKAGES=(
  curl wget git jq htop vim nano openssl
  nfs-common apparmor apparmor-utils
  net-tools dnsutils traceroute
  parted e2fsprogs xfsprogs
  sysstat iotop unzip zip rsync socat
)

log_output() { echo -e "$1" | tee -a "$LOG_FILE"; }

run_remote_command() {
  local command=$1
  local description=$2

  log_output "${YELLOW}$description${NC}"

  if output=$(ssh \
    -o ConnectTimeout=$SSH_TIMEOUT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=QUIET \
    "$SSH_USER@$SERVER_IP" \
    "$command" 2>&1); then
    log_output "${GREEN}✓ Success${NC}"
    return 0
  else
    log_output "${RED}✗ Failed: $output${NC}"
    return 1
  fi
}

echo -e "${BLUE}=== Server Updates & Dependencies ===${NC}\n"

read -p "$(echo -e ${YELLOW}Update system and install dependencies?${NC}) [Y/n]: " proceed
if [[ $proceed =~ ^[Nn]$ ]]; then
  log_output "${YELLOW}Skipping updates and dependencies${NC}\n"
  exit 0
fi

log_output "\n${BLUE}=== Starting System Updates ===${NC}\n"

run_remote_command "sudo apt update" "Step 1: Updating package lists..." || true

run_remote_command "sudo DEBIAN_FRONTEND=noninteractive apt upgrade -y" "Step 2: Upgrading packages..." || true

PACKAGES_STRING="${PACKAGES[*]}"
log_output "${YELLOW}Step 3: Installing packages...${NC}"
if run_remote_command \
  "sudo DEBIAN_FRONTEND=noninteractive apt install -y $PACKAGES_STRING" \
  "  Installing: $PACKAGES_STRING"; then
  log_output "${GREEN}✓ Package installation complete${NC}\n"
else
  log_output "${YELLOW}⚠ Some packages may have failed to install (continuing)${NC}\n"
fi

log_output "${YELLOW}Step 4: Disabling SWAP...${NC}"
swap_status=$(ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "swapon --show" 2>&1)

if [ -z "$swap_status" ]; then
  log_output "${GREEN}✓ SWAP is already disabled${NC}\n"
else
  log_output "  Current SWAP: $swap_status"
  if run_remote_command "sudo swapoff -a" "  Disabling SWAP..."; then
    run_remote_command "sudo sed -i '/ swap / s/^/#/' /etc/fstab" "  Removing swap from fstab..." || true
    log_output "${GREEN}✓ SWAP disabled${NC}\n"
  else
    log_output "${YELLOW}⚠ Failed to disable SWAP (continuing)${NC}\n"
  fi
fi

log_output "${YELLOW}Step 5: Installing Helm${NC}\n"
if run_remote_command \
  "curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | sudo bash" \
  "  Installing Helm via official script..."; then
  log_output "${GREEN}✓ Helm installed${NC}\n"
else
  log_output "${YELLOW}⚠ Helm installation may have failed (check logs)${NC}\n"
fi

log_output "${YELLOW}Step 6: System Information${NC}\n"

log_output "${BLUE}Operating System:${NC}"
ssh -o ConnectTimeout=$SSH_TIMEOUT -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "cat /etc/os-release | grep -E 'PRETTY_NAME|VERSION'" 2>&1 | tee -a "$LOG_FILE"

log_output "\n${BLUE}Kernel:${NC}"
ssh -o ConnectTimeout=$SSH_TIMEOUT -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" "uname -r" 2>&1 | tee -a "$LOG_FILE"

log_output "\n${BLUE}Memory:${NC}"
ssh -o ConnectTimeout=$SSH_TIMEOUT -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" "free -h | tail -2" 2>&1 | tee -a "$LOG_FILE"

log_output "\n${BLUE}Disk Usage:${NC}"
ssh -o ConnectTimeout=$SSH_TIMEOUT -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" "df -h" 2>&1 | tee -a "$LOG_FILE"

log_output "\n${GREEN}=== ✓ Updates and Dependencies Complete ===${NC}\n"
