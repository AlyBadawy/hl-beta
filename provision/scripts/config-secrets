#!/bin/bash

set -e

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Source validation functions from lib
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$(dirname "$SCRIPT_DIR")/lib/validation.sh"

# Setup logging
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CONFIG_DIR="$PROJECT_DIR/config"
LOG_FILE="$PROJECT_DIR/provision.log"
mkdir -p "$CONFIG_DIR"

# Helper function to log output
log_output() {
  local message=$1
  echo -e "$message" | tee -a "$LOG_FILE"
}

log_output "${GREEN}=== K3s Cluster Configuration Setup ===${NC}\n"

# Server Configuration
log_output "${YELLOW}--- Server Configuration ---${NC}"
SERVER_IP=$(prompt_with_validation "Server IP address:" "" validate_ip)
SSH_USER=$(prompt_with_validation "SSH user:" "homelab" "")

# NAS Configuration
log_output "\n${YELLOW}--- NAS Configuration ---${NC}"
NAS_IP=$(prompt_with_validation "NAS server IP:" "172.20.20.2" validate_ip)
NAS_BASE_SHARE=$(prompt_with_validation "NAS base share path:" "/var/nfs/shared" "")
NAS_BASE_MOUNT=$(prompt_with_validation "Base mount path:" "/mnt/nas" "")

# SMTP Configuration
log_output "\n${YELLOW}--- SMTP Configuration ---${NC}"
SMTP_SERVER=$(prompt_with_validation "SMTP server:" "smtp.resend.com" "")
SMTP_PORT=$(prompt_with_validation "SMTP port:" "587" validate_port)
SMTP_USERNAME=$(prompt_with_validation "SMTP username:" "" "")
SMTP_FROM=$(prompt_with_validation "Email to send from:" "" validate_email)

echo -e "${YELLOW}SMTP password:${NC} (input will be hidden)"
read -s SMTP_PASSWORD
echo ""

while [ -z "$SMTP_PASSWORD" ]; do
  echo -e "${RED}SMTP password cannot be empty.${NC}"
  read -sp "SMTP password: " SMTP_PASSWORD
  echo ""
done

# Admin Configuration
log_output "\n${YELLOW}--- Admin Configuration ---${NC}"
ADMIN_EMAIL=$(prompt_with_validation "Admin email:" "" validate_email)

# Domain Configuration
log_output "\n${YELLOW}--- Domain Configuration ---${NC}"
BASE_DOMAIN=$(prompt_with_validation "Base domain:" "in.alybadawy.com" validate_domain)

# Summary and confirmation
log_output "\n${GREEN}=== Configuration Summary ===${NC}"
cat << EOF | tee -a "$LOG_FILE"
Server:
  IP: $SERVER_IP
  SSH User: $SSH_USER

NAS:
  IP: $NAS_IP
  Base Share: $NAS_BASE_SHARE
  Mount Path: $NAS_BASE_MOUNT

SMTP:
  Server: $SMTP_SERVER
  Port: $SMTP_PORT
  Username: $SMTP_USERNAME
  From: $SMTP_FROM

Email:
  Admin: $ADMIN_EMAIL

Domain:
  Base: $BASE_DOMAIN
EOF

log_output ""
read -p "$(echo -e ${YELLOW}Proceed with saving configuration?${NC}) [y/N]: " confirm
if [[ ! $confirm =~ ^[Yy]$ ]]; then
  echo -e "${RED}Configuration cancelled.${NC}"
  exit 1
fi

# Write secrets.yaml
SECRETS_FILE="$CONFIG_DIR/secrets.yaml"
cat > "$SECRETS_FILE" << EOF
# Auto-generated secrets configuration
# DO NOT COMMIT THIS FILE

server:
  ip: $SERVER_IP
  ssh_user: $SSH_USER

nas:
  ip: $NAS_IP
  base_share: $NAS_BASE_SHARE
  base_mount: $NAS_BASE_MOUNT

smtp:
  server: $SMTP_SERVER
  port: $SMTP_PORT
  username: $SMTP_USERNAME
  password: $SMTP_PASSWORD
  from: $SMTP_FROM

email:
  admin: $ADMIN_EMAIL

domain:
  base: $BASE_DOMAIN
EOF

chmod 600 "$SECRETS_FILE"
log_output "${GREEN}✓ Configuration saved to $SECRETS_FILE${NC}"
