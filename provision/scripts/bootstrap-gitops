#!/bin/bash

set -e

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get script directory and load helpers
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
GIT_OPS_DIR="$PROJECT_DIR/git-ops"
CONFIG_FILE="$PROJECT_DIR/config/secrets.yaml"
LOG_FILE="$PROJECT_DIR/provision.log"

# Source config loader
source "$(dirname "$SCRIPT_DIR")/lib/config.sh"

# SSH timeout
SSH_TIMEOUT=5

# Helper function to log output
log_output() {
  local message=$1
  echo -e "$message" | tee -a "$LOG_FILE"
}

log_output "${BLUE}=== Phase 7: Bootstrap GitOps ===${NC}\n"

# Check if git-ops directory exists
if [ ! -d "$GIT_OPS_DIR" ]; then
  log_output "${RED}✗ Error: git-ops directory not found at $GIT_OPS_DIR${NC}"
  exit 1
fi

# Check if root-app directory exists
if [ ! -d "$GIT_OPS_DIR/root-app" ]; then
  log_output "${RED}✗ Error: root-app directory not found at $GIT_OPS_DIR/root-app${NC}"
  exit 1
fi

# Load SSH configuration
log_output "${YELLOW}Loading SSH configuration...${NC}"
if ! load_ssh_config "$CONFIG_FILE"; then
  log_output "${RED}✗ Failed to load SSH configuration${NC}"
  exit 1
fi
log_output "${GREEN}✓ SSH configuration loaded${NC}\n"

# Load Git + Domain configuration
log_output "${YELLOW}Loading Git and Domain configuration...${NC}"
if ! load_git_config "$CONFIG_FILE"; then
  log_output "${RED}✗ Failed to load Git/Domain configuration${NC}"
  exit 1
fi
log_output "${GREEN}✓ Git repo: $GIT_REPO${NC}"
log_output "${GREEN}✓ Domain:   $DOMAIN${NC}\n"

# Load NAS configuration for Longhorn
log_output "${YELLOW}Loading NAS configuration...${NC}"
if ! load_nas_config "$CONFIG_FILE"; then
  log_output "${RED}✗ Failed to load NAS configuration${NC}"
  exit 1
fi
log_output "${GREEN}✓ NAS IP:        $NAS_IP${NC}"
log_output "${GREEN}✓ NAS Base Share: $NAS_BASE_SHARE${NC}\n"

# ─────────────────────────────────────────────────────────────────
# Step 1: Install Nginx Ingress Controller (prerequisite)
# ─────────────────────────────────────────────────────────────────
log_output "${YELLOW}Step 1: Installing Nginx Ingress Controller${NC}\n"

NGINX_REPO="https://kubernetes.github.io/ingress-nginx"
NGINX_CHART_VERSION="4.11.0"
NGINX_VALUES_LOCAL="$GIT_OPS_DIR/nginx-ingress/values.yaml"

# Idempotency check: skip if nginx-ingress controller is already running.
# This covers both a previous bootstrap run AND the case where ArgoCD already manages it.
NGINX_RUNNING=$(kubectl get deployment -n ingress-nginx \
  -l 'app.kubernetes.io/name=ingress-nginx' \
  --no-headers 2>/dev/null | wc -l | tr -d ' ')

if [ "$NGINX_RUNNING" -gt 0 ]; then
  log_output "${GREEN}✓ Nginx Ingress Controller already running — skipping install${NC}\n"
else
  # Add Helm repository on remote server
  log_output "  Adding nginx helm repository..."
  if ssh \
    -o ConnectTimeout=$SSH_TIMEOUT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=QUIET \
    "$SSH_USER@$SERVER_IP" \
    "helm repo add ingress-nginx $NGINX_REPO && helm repo update" >> "$LOG_FILE" 2>&1; then
    log_output "${GREEN}✓ Repository added and updated${NC}"
  else
    log_output "${YELLOW}⚠ Repository may already exist (continuing)${NC}"
  fi

  # Create namespace
  log_output "  Creating ingress-nginx namespace..."
  kubectl create namespace ingress-nginx --dry-run=client -o yaml | kubectl apply -f - >> "$LOG_FILE" 2>&1

  # Install nginx-ingress via Helm on remote server using values from git-ops
  log_output "  Installing nginx-ingress via helm (using git-ops/nginx-ingress/values.yaml)..."
  if ssh \
    -o ConnectTimeout=$SSH_TIMEOUT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=QUIET \
    "$SSH_USER@$SERVER_IP" \
    "export KUBECONFIG=~/.kube/config && helm upgrade --install nginx-ingress ingress-nginx/ingress-nginx \
      --namespace ingress-nginx \
      --version $NGINX_CHART_VERSION \
      --values - \
      --wait \
      --timeout 5m" <<< "$(cat $NGINX_VALUES_LOCAL)" >> "$LOG_FILE" 2>&1; then
    log_output "${GREEN}✓ Nginx Ingress Controller installed${NC}"
  else
    log_output "${RED}✗ Failed to install Nginx Ingress Controller${NC}"
    log_output "${RED}Check logs: tail -50 provision.log${NC}"
    exit 1
  fi

  # Hand off Helm release ownership to ArgoCD.
  # ArgoCD manages resources via kubectl apply (not helm upgrade), so we remove the
  # Helm tracking secret to avoid dual-ownership conflicts. The actual running resources
  # (Deployment, Service, IngressClass, etc.) are preserved — only the Helm metadata is removed.
  # When ArgoCD syncs the nginx-ingress Application, it will adopt and fully manage these resources.
  log_output "  Handing off nginx-ingress ownership to ArgoCD (removing Helm tracking secret)..."
  kubectl delete secret \
    --namespace ingress-nginx \
    --selector "owner=helm,name=nginx-ingress" \
    --ignore-not-found >> "$LOG_FILE" 2>&1
  log_output "${GREEN}✓ Nginx Ingress Controller ready for ArgoCD management${NC}\n"
fi

# ─────────────────────────────────────────────────────────────────
# Step 2: Create ArgoCD namespace
# ─────────────────────────────────────────────────────────────────
log_output "${YELLOW}Step 2: Creating ArgoCD namespace${NC}\n"

if kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f - >> "$LOG_FILE" 2>&1; then
  log_output "${GREEN}✓ ArgoCD namespace created${NC}\n"
else
  log_output "${RED}✗ Failed to create ArgoCD namespace${NC}"
  exit 1
fi

# ─────────────────────────────────────────────────────────────────
# Step 3: Install ArgoCD via Helm (bootstrap only)
# ─────────────────────────────────────────────────────────────────
log_output "${YELLOW}Step 3: Installing ArgoCD via Helm${NC}\n"

ARGOCD_REPO="https://argoproj.github.io/argo-helm"
ARGOCD_CHART_VERSION="7.6.0"

# Idempotency check: skip if ArgoCD server is already running.
ARGOCD_RUNNING=$(kubectl get deployment -n argocd argocd-server --no-headers 2>/dev/null | wc -l | tr -d ' ')

if [ "$ARGOCD_RUNNING" -gt 0 ]; then
  log_output "${GREEN}✓ ArgoCD already running — skipping install${NC}\n"
else
  # Add ArgoCD helm repository on remote server
  log_output "  Adding ArgoCD helm repository..."
  if ssh \
    -o ConnectTimeout=$SSH_TIMEOUT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=QUIET \
    "$SSH_USER@$SERVER_IP" \
    "helm repo add argo $ARGOCD_REPO && helm repo update" >> "$LOG_FILE" 2>&1; then
    log_output "${GREEN}✓ Repository added and updated${NC}"
  else
    log_output "${YELLOW}⚠ Repository may already exist (continuing)${NC}"
  fi

  log_output ""

  # Bootstrap values: minimal config to get ArgoCD running.
  # Full configuration is applied by ArgoCD self-management once the root-app syncs
  # (using git-ops/argocd/values.yaml via the argocd Application in root-app).
  ARGOCD_BOOTSTRAP_VALUES=$(cat <<'HELM_EOF'
server:
  replicas: 1
  insecure: true
  ingress:
    enabled: false

controller:
  replicas: 1

repoServer:
  replicas: 1

persistence:
  enabled: false

redis:
  enabled: true

configs:
  cm:
    server.disable.auth: "false"
    server.insecure: "true"
HELM_EOF
)

  log_output "  Installing ArgoCD via helm (bootstrap values)..."
  if ssh \
    -o ConnectTimeout=$SSH_TIMEOUT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=QUIET \
    "$SSH_USER@$SERVER_IP" \
    "export KUBECONFIG=~/.kube/config && helm upgrade --install argocd argo/argo-cd \
      --namespace argocd \
      --version $ARGOCD_CHART_VERSION \
      --values - \
      --wait \
      --timeout 5m" <<< "$ARGOCD_BOOTSTRAP_VALUES" >> "$LOG_FILE" 2>&1; then
    log_output "${GREEN}✓ ArgoCD installed${NC}"
  else
    log_output "${RED}✗ Failed to install ArgoCD${NC}"
    log_output "${RED}Check logs: tail -50 provision.log${NC}"
    exit 1
  fi

  # Hand off ArgoCD's Helm release ownership to ArgoCD self-management.
  # Same reasoning as nginx-ingress: ArgoCD uses kubectl apply, not helm upgrade.
  # The argocd Application in root-app will adopt and fully manage ArgoCD going forward.
  log_output "  Handing off ArgoCD ownership to self-management (removing Helm tracking secret)..."
  kubectl delete secret \
    --namespace argocd \
    --selector "owner=helm,name=argocd" \
    --ignore-not-found >> "$LOG_FILE" 2>&1
  log_output "${GREEN}✓ ArgoCD ready for self-management${NC}\n"
fi

# ─────────────────────────────────────────────────────────────────
# Step 4: Create bootstrap root-app Application
# ─────────────────────────────────────────────────────────────────
log_output "${YELLOW}Step 4: Creating bootstrap Application${NC}\n"

# Note: uses $GIT_REPO and $DOMAIN loaded from config/secrets.yaml above.
# These are injected as helm.parameters so root-app/values.yaml stays free
# of instance-specific hardcoded values.
BOOTSTRAP_MANIFEST=$(cat <<EOF
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root-app
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: $GIT_REPO
    targetRevision: main
    path: git-ops/root-app
    helm:
      parameters:
        - name: domain
          value: "$DOMAIN"
        - name: git.repoUrl
          value: "$GIT_REPO"
        - name: nas.ip
          value: "$NAS_IP"
        - name: nas.baseShare
          value: "$NAS_BASE_SHARE"
  destination:
    server: https://kubernetes.default.svc
    namespace: default
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 3m
EOF
)

log_output "  Applying bootstrap Application manifest..."
echo "$BOOTSTRAP_MANIFEST" | kubectl apply -f - >> "$LOG_FILE" 2>&1
log_output "${GREEN}✓ Bootstrap Application created${NC}\n"

# ─────────────────────────────────────────────────────────────────
# Step 5: Wait for ArgoCD to be ready
# ─────────────────────────────────────────────────────────────────
log_output "${YELLOW}Step 5: Waiting for ArgoCD to become ready${NC}\n"

log_output "  Waiting for ArgoCD server deployment (up to 3 minutes)..."
if kubectl rollout status deployment/argocd-server -n argocd --timeout=3m >> "$LOG_FILE" 2>&1; then
  log_output "${GREEN}✓ ArgoCD server is running${NC}\n"
else
  log_output "${YELLOW}⚠ ArgoCD server did not start in time (continuing)${NC}\n"
fi

# ─────────────────────────────────────────────────────────────────
# Step 6: Retrieve ArgoCD admin credentials
# ─────────────────────────────────────────────────────────────────
log_output "${YELLOW}Step 6: Retrieving ArgoCD admin credentials${NC}\n"

ADMIN_PASSWORD=""
for i in {1..30}; do
  ADMIN_PASSWORD=$(kubectl get secret -n argocd argocd-initial-admin-secret \
    -o jsonpath="{.data.password}" 2>/dev/null | base64 -d 2>/dev/null || echo "")
  if [ -n "$ADMIN_PASSWORD" ]; then
    log_output "${GREEN}✓ Admin credentials retrieved${NC}\n"
    break
  fi

  if [ $i -eq 30 ]; then
    log_output "${YELLOW}⚠ Could not retrieve admin password (may still be initializing)${NC}\n"
    ADMIN_PASSWORD="Run: kubectl get secret -n argocd argocd-initial-admin-secret -o jsonpath=\"{.data.password}\" | base64 -d"
    break
  fi

  log_output "  Attempt $i/30: Waiting for admin secret..."
  sleep 2
done

# ─────────────────────────────────────────────────────────────────
# Done
# ─────────────────────────────────────────────────────────────────
log_output "${GREEN}=== ✓ GitOps Bootstrap Complete ===${NC}\n"

log_output "${YELLOW}Access ArgoCD (port-forward — use this until root-app syncs):${NC}"
log_output "  kubectl port-forward -n argocd svc/argocd-server 8080:80"
log_output "  Visit: http://localhost:8080"
log_output "  Username: admin"
if echo "$ADMIN_PASSWORD" | grep -q "^Run:"; then
  log_output "  Password: $ADMIN_PASSWORD"
else
  log_output "  Password: $ADMIN_PASSWORD"
fi
log_output ""

log_output "${YELLOW}What happens next (automatic):${NC}"
log_output "  1. ArgoCD syncs root-app from git"
log_output "  2. root-app creates the nginx-ingress Application → ArgoCD adopts the running controller"
log_output "  3. root-app creates the argocd Application → ArgoCD self-manages itself"
log_output "  4. root-app applies the ArgoCD Ingress (argo.${DOMAIN})"
log_output "  5. Once DNS argo.${DOMAIN} → server IP is set, the UI is accessible at http://argo.${DOMAIN}"
log_output ""

log_output "${YELLOW}Monitor sync status:${NC}"
log_output "  kubectl get applications -n argocd"
log_output "  kubectl describe application root-app -n argocd"
log_output ""

log_output "${YELLOW}View ArgoCD server logs:${NC}"
log_output "  kubectl logs -n argocd deployment/argocd-server -f"
log_output ""

log_output "${BLUE}Log saved to: $LOG_FILE${NC}\n"
