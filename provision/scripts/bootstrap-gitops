#!/bin/bash

set -e

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get script directory and load helpers
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
GIT_OPS_DIR="$PROJECT_DIR/git-ops"
LOG_FILE="$PROJECT_DIR/provision.log"

# Helper function to log output
log_output() {
  local message=$1
  echo -e "$message" | tee -a "$LOG_FILE"
}

log_output "${BLUE}=== Phase 7: Bootstrap GitOps ===${NC}\n"

# Check if git-ops directory exists
if [ ! -d "$GIT_OPS_DIR" ]; then
  log_output "${RED}✗ Error: git-ops directory not found at $GIT_OPS_DIR${NC}"
  exit 1
fi

# Check if root-app directory exists
if [ ! -d "$GIT_OPS_DIR/root-app" ]; then
  log_output "${RED}✗ Error: root-app directory not found at $GIT_OPS_DIR/root-app${NC}"
  exit 1
fi

# Step 1: Install Nginx Ingress Controller (prerequisite)
log_output "${YELLOW}Step 1: Installing Nginx Ingress Controller${NC}\n"

NGINX_REPO="https://kubernetes.github.io/ingress-nginx"
NGINX_CHART_VERSION="4.11.0"

# Add Helm repository
log_output "  Adding nginx helm repository..."
if helm repo add ingress-nginx "$NGINX_REPO" 2>&1 | grep -q "already exists"; then
  log_output "  Repository already exists, updating..."
  helm repo update ingress-nginx >> "$LOG_FILE" 2>&1
else
  log_output "  Repository added"
fi

# Create ingress-nginx namespace
log_output "  Creating ingress-nginx namespace..."
kubectl create namespace ingress-nginx --dry-run=client -o yaml | kubectl apply -f - >> "$LOG_FILE" 2>&1

# Install or upgrade nginx-ingress using helm
log_output "  Installing nginx-ingress via helm..."
if helm upgrade --install nginx-ingress ingress-nginx/ingress-nginx \
  --namespace ingress-nginx \
  --values "$GIT_OPS_DIR/nginx-ingress/values.yaml" \
  --chart-version "$NGINX_CHART_VERSION" \
  --wait \
  --timeout 5m >> "$LOG_FILE" 2>&1; then
  log_output "${GREEN}✓ Nginx Ingress Controller installed${NC}\n"
else
  log_output "${RED}✗ Failed to install Nginx Ingress Controller${NC}"
  exit 1
fi

# Step 2: Create ArgoCD namespace
log_output "${YELLOW}Step 2: Creating ArgoCD namespace${NC}\n"

if kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f - >> "$LOG_FILE" 2>&1; then
  log_output "${GREEN}✓ ArgoCD namespace created${NC}\n"
else
  log_output "${RED}✗ Failed to create ArgoCD namespace${NC}"
  exit 1
fi

# Step 3: Create bootstrap Application manifest
log_output "${YELLOW}Step 3: Creating bootstrap Application${NC}\n"

BOOTSTRAP_MANIFEST=$(cat <<'EOF'
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root-app
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: https://github.com/AlyBadawy/hl-beta
    targetRevision: main
    path: git-ops/root-app
  destination:
    server: https://kubernetes.default.svc
    namespace: default
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 3m
EOF
)

# Apply bootstrap application
log_output "  Applying bootstrap Application manifest..."
echo "$BOOTSTRAP_MANIFEST" | kubectl apply -f - >> "$LOG_FILE" 2>&1

log_output "${GREEN}✓ Bootstrap Application created${NC}\n"

# Step 4: Wait for ArgoCD to be ready
log_output "${YELLOW}Step 4: Waiting for ArgoCD to become ready${NC}\n"

# Wait for argocd-server deployment
log_output "  Waiting for ArgoCD server deployment (up to 3 minutes)..."
if kubectl rollout status deployment/argocd-server -n argocd --timeout=3m >> "$LOG_FILE" 2>&1; then
  log_output "${GREEN}✓ ArgoCD server is running${NC}\n"
else
  log_output "${YELLOW}⚠ ArgoCD server did not start in time (continuing)${NC}\n"
fi

# Step 5: Get ArgoCD initial admin password
log_output "${YELLOW}Step 5: Retrieving ArgoCD admin credentials${NC}\n"

ADMIN_PASSWORD=""
for i in {1..30}; do
  ADMIN_PASSWORD=$(kubectl get secret -n argocd argocd-initial-admin-secret -o jsonpath="{.data.password}" 2>/dev/null | base64 -d 2>/dev/null || echo "")
  if [ -n "$ADMIN_PASSWORD" ]; then
    log_output "${GREEN}✓ Admin credentials retrieved${NC}\n"
    break
  fi

  if [ $i -eq 30 ]; then
    log_output "${YELLOW}⚠ Could not retrieve admin password (may still be initializing)${NC}\n"
    ADMIN_PASSWORD="Check with: kubectl get secret -n argocd argocd-initial-admin-secret -o jsonpath=\"{.data.password}\" | base64 -d"
    break
  fi

  log_output "  Attempt $i/30: Waiting for admin secret..."
  sleep 2
done

# Step 6: Display access information
log_output "${GREEN}=== ✓ GitOps Bootstrap Complete ===${NC}\n"

log_output "${YELLOW}Access ArgoCD:${NC}\n"
log_output "  ${BLUE}URL: http://argo.in.alybadawy.com${NC}"
log_output "  ${BLUE}Username: admin${NC}"

if [ "$ADMIN_PASSWORD" != "Check with: kubectl get secret -n argocd argocd-initial-admin-secret -o jsonpath=\"{.data.password}\" | base64 -d" ]; then
  log_output "  ${BLUE}Password: $ADMIN_PASSWORD${NC}\n"
else
  log_output "  ${BLUE}Password:${NC} $ADMIN_PASSWORD\n"
fi

log_output "${YELLOW}Port Forward (if ingress not working):${NC}"
log_output "  kubectl port-forward -n argocd svc/argocd-server 8080:80"
log_output "  Visit: http://localhost:8080\n"

log_output "${YELLOW}Verify root-app status:${NC}"
log_output "  kubectl get applications -n argocd"
log_output "  kubectl describe application root-app -n argocd\n"

log_output "${YELLOW}View ArgoCD logs:${NC}"
log_output "  kubectl logs -n argocd deployment/argocd-server -f\n"

log_output "${BLUE}Next steps:${NC}"
log_output "  1. Wait for Nginx Ingress Controller to get an IP (LoadBalancer)"
log_output "  2. Point DNS argo.in.alybadawy.com to cluster IP"
log_output "  3. Access ArgoCD UI at http://argo.in.alybadawy.com"
log_output "  4. Monitor root-app syncing in the UI"
log_output "  5. Once stable, change admin password\n"

log_output "${BLUE}Log saved to: $LOG_FILE${NC}\n"
