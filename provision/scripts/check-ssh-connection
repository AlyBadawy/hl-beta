#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
LOG_FILE="$PROJECT_DIR/provision.log"

source "$(dirname "$SCRIPT_DIR")/lib/defaults.sh"
require_server_ip

log_output "${BLUE}=== SSH Connection Validation ===${NC}\n"
log_output "  Server IP: ${BLUE}$SERVER_IP${NC}"
log_output "  SSH User:  ${BLUE}$SSH_USER${NC}\n"

# Test 1: Basic SSH connectivity
log_output "${YELLOW}Test 1: SSH Connectivity${NC}"

SSH_OUTPUT=$(ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "whoami" 2>&1) || {
  log_output "${RED}✗ SSH connection failed: $SSH_OUTPUT${NC}"
  exit 1
}

SSH_OUTPUT=$(echo "$SSH_OUTPUT" | tr -d '\n' | xargs)

if [ "$SSH_OUTPUT" != "$SSH_USER" ]; then
  log_output "${RED}✗ SSH user mismatch — expected: $SSH_USER, got: $SSH_OUTPUT${NC}"
  exit 1
fi

log_output "${GREEN}✓ SSH connectivity verified (remote user: $SSH_OUTPUT)${NC}\n"

# Test 2: NOPASSWD sudo access
log_output "${YELLOW}Test 2: NOPASSWD Sudo Access${NC}"

SUDO_OUTPUT=$(ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "sudo whoami" 2>&1) || {
  log_output "${RED}✗ Sudo command failed: $SUDO_OUTPUT${NC}"
  log_output "${YELLOW}Make sure $SSH_USER has NOPASSWD sudo access${NC}"
  exit 1
}

SUDO_OUTPUT=$(echo "$SUDO_OUTPUT" | tr -d '\n' | xargs)

if [ "$SUDO_OUTPUT" != "root" ]; then
  log_output "${RED}✗ Sudo verification failed — expected: root, got: $SUDO_OUTPUT${NC}"
  exit 1
fi

log_output "${GREEN}✓ NOPASSWD sudo access verified${NC}\n"
log_output "${GREEN}=== ✓ All SSH Checks Passed ===${NC}"
echo -e "${BLUE}Server is ready for provisioning${NC}\n"
