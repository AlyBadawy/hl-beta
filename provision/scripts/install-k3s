#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
LOG_FILE="$PROJECT_DIR/provision.log"

source "$(dirname "$SCRIPT_DIR")/lib/defaults.sh"
require_server_ip

K3S_VERSION="v1.36.1+k3s1"
K3S_INSTALL_EXEC="--disable=traefik"

log_output "${BLUE}=== K3s Installation ===${NC}\n"

# Step 1: Write k3s config and graceful shutdown configuration.
# In k3s v1.36+ (K8s 1.35+), shutdown-grace-period is no longer a CLI flag —
# it must live in a KubeletConfiguration drop-in. The kubelet config-dir is
# /var/lib/rancher/k3s/agent/etc/kubelet.conf.d/; we drop 99-shutdown-grace.conf
# there. The logind drop-in (zz-kubelet-shutdown.conf) must sort AFTER
# unattended-upgrades-logind-maxdelay.conf alphabetically so it wins the merge.
log_output "${YELLOW}Step 1: Writing K3s Config and Graceful Shutdown Settings${NC}"

ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "sudo mkdir -p /etc/rancher/k3s && sudo tee /etc/rancher/k3s/config.yaml > /dev/null <<'K3SCFG'
disable:
  - traefik
K3SCFG" \
  >> "$LOG_FILE" 2>&1 \
  && log_output "${GREEN}✓ /etc/rancher/k3s/config.yaml written${NC}" \
  || { log_output "${RED}✗ Failed to write k3s config${NC}"; exit 1; }

ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "sudo mkdir -p /var/lib/rancher/k3s/agent/etc/kubelet.conf.d && sudo tee /var/lib/rancher/k3s/agent/etc/kubelet.conf.d/99-shutdown-grace.conf > /dev/null <<'KUBECFG'
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
shutdownGracePeriodByPodPriority:
  - priority: 0
    shutdownGracePeriodSeconds: 10
  - priority: 500000
    shutdownGracePeriodSeconds: 8
  - priority: 2000000000
    shutdownGracePeriodSeconds: 7
KUBECFG" \
  >> "$LOG_FILE" 2>&1 \
  && log_output "${GREEN}✓ kubelet drop-in written (3-bucket shutdown: 10s + 8s + 7s = 25s)${NC}" \
  || { log_output "${RED}✗ Failed to write kubelet shutdown drop-in${NC}"; exit 1; }

# logind InhibitDelayMaxSec must be >= total shutdown window (25s) so kubelet can
# register the systemd inhibitor lock. unattended-upgrades sets it to 30s in
# /usr/lib/systemd/logind.conf.d/ — logind merges ALL conf.d files across all
# search paths in combined alphabetical order; zz-* sorts after unattended-upgrades-*.
ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "sudo mkdir -p /etc/systemd/logind.conf.d && sudo tee /etc/systemd/logind.conf.d/zz-kubelet-shutdown.conf > /dev/null <<'LOGIND'
[Login]
InhibitDelayMaxSec=30
LOGIND
sudo systemctl daemon-reload && sudo systemctl restart systemd-logind" \
  >> "$LOG_FILE" 2>&1 \
  && log_output "${GREEN}✓ logind InhibitDelayMaxSec=30 written and reloaded${NC}" \
  || { log_output "${RED}✗ Failed to write logind config${NC}"; exit 1; }

# systemd flag service: sets /run/longhorn-node-shutdown BEFORE k3s begins its
# graceful shutdown window. The Longhorn shutdown-agent DaemonSet (priority 500000)
# checks for this flag in its preStop hook so it only force-unmounts iSCSI volumes
# during real node shutdowns, not during normal pod rollouts.
ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "sudo tee /etc/systemd/system/longhorn-shutdown-flag.service > /dev/null <<'SVC'
[Unit]
Description=Set Longhorn node-shutdown flag for graceful iSCSI cleanup
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target poweroff.target
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/rm -f /run/longhorn-node-shutdown
ExecStop=/bin/touch /run/longhorn-node-shutdown
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
SVC
sudo systemctl daemon-reload && sudo systemctl enable longhorn-shutdown-flag.service && sudo systemctl start longhorn-shutdown-flag.service" \
  >> "$LOG_FILE" 2>&1 \
  && log_output "${GREEN}✓ longhorn-shutdown-flag.service installed and started${NC}\n" \
  || { log_output "${RED}✗ Failed to install longhorn-shutdown-flag.service${NC}"; exit 1; }

# Step 2: Check if k3s is already installed
log_output "${YELLOW}Step 2: Checking K3s Installation Status${NC}"

k3s_installed=$(ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "command -v k3s >/dev/null 2>&1 && echo 'installed' || echo 'not_installed'" 2>&1)

if [[ "$k3s_installed" == "installed" ]]; then
  current_version=$(ssh \
    -o ConnectTimeout=$SSH_TIMEOUT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=QUIET \
    "$SSH_USER@$SERVER_IP" \
    "k3s --version" 2>&1)
  log_output "${GREEN}✓ K3s already installed: $current_version${NC}"
  log_output "${YELLOW}Restarting k3s to apply updated config...${NC}"

  ssh \
    -o ConnectTimeout=$SSH_TIMEOUT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=QUIET \
    "$SSH_USER@$SERVER_IP" \
    "sudo systemctl restart k3s && sleep 5" \
    >> "$LOG_FILE" 2>&1 \
    && log_output "${GREEN}✓ K3s restarted${NC}\n" \
    || { log_output "${RED}✗ Failed to restart k3s${NC}"; exit 1; }

else
  log_output "${YELLOW}K3s not found, installing...${NC}\n"

  log_output "${YELLOW}Step 3: Installing K3s ${K3S_VERSION}${NC}"
  log_output "  This may take 2-5 minutes...\n"

  run_remote_command \
    "curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION=$K3S_VERSION INSTALL_K3S_EXEC='$K3S_INSTALL_EXEC' sh -s - server" \
    "  Downloading and installing K3s..."

  log_output ""

  log_output "${YELLOW}Step 4: Waiting for K3s to Initialize${NC}"
  for i in {1..30}; do
    service_status=$(ssh \
      -o ConnectTimeout=$SSH_TIMEOUT \
      -o StrictHostKeyChecking=no \
      -o UserKnownHostsFile=/dev/null \
      -o LogLevel=QUIET \
      "$SSH_USER@$SERVER_IP" \
      "sudo systemctl is-active k3s" 2>&1 || echo "inactive")

    if [[ "$service_status" == "active" ]]; then
      log_output "${GREEN}✓ K3s service is running${NC}\n"
      break
    fi

    if [ $i -eq 30 ]; then
      log_output "${RED}✗ K3s service failed to start after 30 attempts${NC}"
      exit 1
    fi

    log_output "  Attempt $i/30: Waiting... ($((i * 2))s elapsed)"
    sleep 2
  done
fi

# Step 5: Verify cluster readiness
log_output "${YELLOW}Step 5: Verifying K3s Cluster Readiness${NC}\n"

kubectl_check=$(ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "sudo k3s kubectl cluster-info 2>&1 | head -1" 2>&1)

if [[ "$kubectl_check" == *"Kubernetes control plane is running"* ]]; then
  log_output "${GREEN}✓ kubectl connected to cluster${NC}\n"
else
  log_output "${YELLOW}⚠ Could not verify kubectl connection (continuing)${NC}\n"
fi

node_status=$(ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "sudo k3s kubectl get nodes -o wide" 2>&1)

log_output "${BLUE}Node Status:${NC}"
echo "$node_status" | tee -a "$LOG_FILE"
log_output ""

node_ready=$(echo "$node_status" | grep -E "Ready|NotReady" | tail -1)
if [[ "$node_ready" == *"Ready"* ]]; then
  log_output "${GREEN}✓ Node is in Ready state${NC}\n"
else
  log_output "${YELLOW}⚠ Node not Ready yet (may still be initializing)${NC}\n"
fi

# Step 6: Copy kubeconfig locally
log_output "${YELLOW}Step 6: Setting Up Local Kubeconfig${NC}\n"

KUBE_DIR="$HOME/.kube"
KUBE_CONFIG="$KUBE_DIR/config"
mkdir -p "$KUBE_DIR"

if ssh -o ConnectTimeout=$SSH_TIMEOUT \
       -o StrictHostKeyChecking=no \
       -o UserKnownHostsFile=/dev/null \
       -o LogLevel=QUIET \
       "$SSH_USER@$SERVER_IP" \
       "sudo cat /etc/rancher/k3s/k3s.yaml" > "$KUBE_CONFIG" 2>&1; then

  chmod 600 "$KUBE_CONFIG"
  log_output "${GREEN}✓ Kubeconfig copied to $KUBE_CONFIG${NC}"

  if [[ "$OSTYPE" == "darwin"* ]]; then
    sed -i '' "s|server: https://127.0.0.1:6443|server: https://$SERVER_IP:6443|g" "$KUBE_CONFIG"
  else
    sed -i "s|server: https://127.0.0.1:6443|server: https://$SERVER_IP:6443|g" "$KUBE_CONFIG"
  fi
  log_output "${GREEN}✓ Server address updated to $SERVER_IP:6443${NC}\n"

  KUBECONFIG_EXPORT="export KUBECONFIG=\"$KUBE_CONFIG\""
  for profile in "$HOME/.bashrc" "$HOME/.zshrc"; do
    if [ -f "$profile" ] && ! grep -q "export KUBECONFIG" "$profile" 2>/dev/null; then
      { echo ""; echo "# K3s kubeconfig"; echo "$KUBECONFIG_EXPORT"; } >> "$profile"
      log_output "  ✓ Added KUBECONFIG to $profile"
    fi
  done

  export KUBECONFIG="$KUBE_CONFIG"
  log_output "  ✓ KUBECONFIG exported for current session\n"
else
  log_output "${YELLOW}⚠ Failed to copy kubeconfig — manual copy:${NC}"
  log_output "  ssh $SSH_USER@$SERVER_IP \"sudo cat /etc/rancher/k3s/k3s.yaml\" > $KUBE_CONFIG"
fi

# Step 7: Copy kubeconfig to remote user
log_output "${YELLOW}Step 7: Setting Up Remote Kubeconfig${NC}\n"

ssh -o ConnectTimeout=$SSH_TIMEOUT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=QUIET \
    "$SSH_USER@$SERVER_IP" \
    "mkdir -p ~/.kube && sudo cat /etc/rancher/k3s/k3s.yaml > ~/.kube/config && chmod 600 ~/.kube/config" \
    >> "$LOG_FILE" 2>&1 \
  && log_output "${GREEN}✓ Kubeconfig copied to remote user ~/.kube/config${NC}\n" \
  || log_output "${YELLOW}⚠ Failed to copy kubeconfig to remote user (continuing)${NC}\n"

# Step 8: Install Helm on remote server
log_output "${YELLOW}Step 8: Installing Helm on Remote Server${NC}\n"

helm_installed=$(ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "command -v helm >/dev/null 2>&1 && echo 'installed' || echo 'not_installed'" 2>&1)

if [[ "$helm_installed" == "installed" ]]; then
  helm_version=$(ssh \
    -o ConnectTimeout=$SSH_TIMEOUT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=QUIET \
    "$SSH_USER@$SERVER_IP" \
    "helm version --short" 2>&1)
  log_output "${GREEN}✓ Helm already installed: $helm_version${NC}\n"
else
  if ssh \
    -o ConnectTimeout=$SSH_TIMEOUT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=QUIET \
    "$SSH_USER@$SERVER_IP" \
    "curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash" \
    >> "$LOG_FILE" 2>&1; then
    helm_version=$(ssh \
      -o ConnectTimeout=$SSH_TIMEOUT \
      -o StrictHostKeyChecking=no \
      -o UserKnownHostsFile=/dev/null \
      -o LogLevel=QUIET \
      "$SSH_USER@$SERVER_IP" \
      "helm version --short" 2>&1)
    log_output "${GREEN}✓ Helm installed: $helm_version${NC}\n"
  else
    log_output "${RED}✗ Failed to install Helm${NC}"
    exit 1
  fi
fi

log_output "${GREEN}=== ✓ K3s + Helm Installation Complete ===${NC}\n"
