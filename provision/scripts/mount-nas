#!/bin/bash

set -e

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get script directory and load helpers
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
CONFIG_FILE="$PROJECT_DIR/config/secrets.yaml"
LOG_FILE="$PROJECT_DIR/provision.log"

# Source config loader
source "$(dirname "$SCRIPT_DIR")/lib/config.sh"

# SSH timeout
SSH_TIMEOUT=5

# NAS mount points to create
MOUNT_POINTS=("homelab" "backups" "immich" "nextcloud")

# Helper function to log output
log_output() {
  local message=$1
  echo -e "$message" | tee -a "$LOG_FILE"
}

# Helper function to run remote SSH command
run_remote_command() {
  local command=$1
  local description=$2
  local fail_on_error=${3:-true}

  log_output "${YELLOW}$description${NC}"

  if output=$(ssh \
    -o ConnectTimeout=$SSH_TIMEOUT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=QUIET \
    "$SSH_USER@$SERVER_IP" \
    "$command" 2>&1); then
    log_output "${GREEN}✓ Success${NC}"
    return 0
  else
    log_output "${RED}✗ Failed${NC}"
    log_output "${RED}Error: $output${NC}"

    if [ "$fail_on_error" = "true" ]; then
      return 1
    else
      return 0
    fi
  fi
}

log_output "${BLUE}=== NAS Mount Setup ===${NC}\n"

# Check if config file exists
if [ ! -f "$CONFIG_FILE" ]; then
  log_output "${RED}✗ Error: Configuration file not found at $CONFIG_FILE${NC}"
  exit 1
fi

# Load SSH configuration
log_output "${YELLOW}Loading SSH configuration...${NC}"
if ! load_ssh_config "$CONFIG_FILE"; then
  log_output "${RED}✗ Failed to load SSH configuration${NC}"
  exit 1
fi

log_output "${GREEN}✓ SSH configuration loaded${NC}"

# Load NAS configuration
log_output "${YELLOW}Loading NAS configuration...${NC}"
if ! load_nas_config "$CONFIG_FILE"; then
  log_output "${RED}✗ Failed to load NAS configuration${NC}"
  exit 1
fi

log_output "${GREEN}✓ NAS configuration loaded${NC}"
log_output "  NAS IP: ${BLUE}$NAS_IP${NC}"
log_output "  Base Share: ${BLUE}$NAS_BASE_SHARE${NC}"
log_output "  Base Mount: ${BLUE}$NAS_BASE_MOUNT${NC}\n"

# Step 1: Test NAS connectivity
log_output "${YELLOW}Step 1: Testing NAS Connectivity${NC}"
if run_remote_command "timeout 5 showmount -e $NAS_IP 2>/dev/null | head -1" "  Checking NAS availability..." false; then
  log_output "${GREEN}✓ NAS is reachable${NC}\n"
else
  log_output "${YELLOW}⚠ Could not verify NAS (continuing anyway)${NC}\n"
fi

# Step 2: Create mount directories
log_output "${YELLOW}Step 2: Creating Mount Directories${NC}"
for mount_point in "${MOUNT_POINTS[@]}"; do
  mount_path="$NAS_BASE_MOUNT/$mount_point"
  run_remote_command "sudo mkdir -p $mount_path" "  Creating $mount_path..." || true
done
log_output ""

# Step 3: Update fstab with NFS entries
log_output "${YELLOW}Step 3: Updating /etc/fstab${NC}"

# NFS mount options
NFS_OPTIONS="defaults,_netdev,nofail,x-systemd.automount,x-systemd.mount-timeout=10"

for mount_point in "${MOUNT_POINTS[@]}"; do
  nfs_source="$NAS_IP:$NAS_BASE_SHARE/$mount_point"
  mount_path="$NAS_BASE_MOUNT/$mount_point"
  fstab_entry="$nfs_source    $mount_path    nfs    $NFS_OPTIONS    0    0"

  log_output "  Checking $mount_point entry..."

  # Check if this exact entry already exists in fstab
  entry_exists=$(ssh \
    -o ConnectTimeout=$SSH_TIMEOUT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=QUIET \
    "$SSH_USER@$SERVER_IP" \
    "grep -F '$nfs_source' /etc/fstab 2>/dev/null || echo 'not found'" 2>&1)

  if [[ "$entry_exists" == *"$nfs_source"* ]]; then
    log_output "    ${YELLOW}→ Already in fstab, skipping${NC}"
  else
    log_output "    ${YELLOW}→ Adding to fstab${NC}"
    # Add entry to fstab
    run_remote_command "echo '$fstab_entry' | sudo tee -a /etc/fstab > /dev/null" "    Writing entry..." || true
  fi
done
log_output ""

# Step 4: Create /etc/fstab backup
log_output "${YELLOW}Step 4: Backing up /etc/fstab${NC}"
run_remote_command "sudo cp /etc/fstab /etc/fstab.backup.$(date +%Y%m%d_%H%M%S)" "  Creating backup..." || true
log_output ""

# Step 5: Mount filesystems
log_output "${YELLOW}Step 5: Mounting NFS Filesystems${NC}"

# First reload systemd daemon to pick up new mount units
run_remote_command "sudo systemctl daemon-reload" "  Reloading systemd..." || true

for mount_point in "${MOUNT_POINTS[@]}"; do
  mount_path="$NAS_BASE_MOUNT/$mount_point"
  nfs_source="$NAS_IP:$NAS_BASE_SHARE/$mount_point"

  # Check if already mounted
  is_mounted=$(ssh \
    -o ConnectTimeout=$SSH_TIMEOUT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o LogLevel=QUIET \
    "$SSH_USER@$SERVER_IP" \
    "mountpoint -q $mount_path && echo 'mounted' || echo 'not_mounted'" 2>&1)

  if [[ "$is_mounted" == "mounted" ]]; then
    log_output "  ${GREEN}✓ $mount_path already mounted${NC}"
  else
    run_remote_command "sudo mount -a -t nfs" "  Mounting $mount_point..." || true

    # Verify mount succeeded
    verify=$(ssh \
      -o ConnectTimeout=$SSH_TIMEOUT \
      -o StrictHostKeyChecking=no \
      -o UserKnownHostsFile=/dev/null \
      -o LogLevel=QUIET \
      "$SSH_USER@$SERVER_IP" \
      "mountpoint -q $mount_path && echo 'mounted' || echo 'not_mounted'" 2>&1)

    if [[ "$verify" == "mounted" ]]; then
      log_output "  ${GREEN}✓ $mount_path mounted successfully${NC}"
    else
      log_output "  ${YELLOW}⚠ Could not verify mount for $mount_point${NC}"
    fi
  fi
done
log_output ""

# Step 6: Display mount status
log_output "${YELLOW}Step 6: Current Mount Status${NC}\n"

log_output "${BLUE}NFS Mounts:${NC}"
ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "mount | grep nfs" 2>&1 | tee -a "$LOG_FILE"

log_output ""
log_output "${BLUE}Disk Space:${NC}"
ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "df -h | grep $NAS_BASE_MOUNT" 2>&1 | tee -a "$LOG_FILE"

log_output "\n${GREEN}=== ✓ NAS Mount Setup Complete ===${NC}\n"
log_output "${BLUE}Log saved to: $LOG_FILE${NC}\n"
