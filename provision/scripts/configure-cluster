#!/bin/bash

set -e

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get script directory and load helpers
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
CONFIG_FILE="$PROJECT_DIR/config/secrets.yaml"
LOG_FILE="$PROJECT_DIR/provision.log"

# Source config loader
source "$(dirname "$SCRIPT_DIR")/lib/config.sh"

# SSH timeout
SSH_TIMEOUT=5

# Helper function to log output
log_output() {
  local message=$1
  echo -e "$message" | tee -a "$LOG_FILE"
}

log_output "${BLUE}=== Cluster Configuration ===${NC}\n"

# Check if config file exists
if [ ! -f "$CONFIG_FILE" ]; then
  log_output "${RED}✗ Error: Configuration file not found at $CONFIG_FILE${NC}"
  exit 1
fi

# Load all configuration sections
log_output "${YELLOW}Loading cluster configuration...${NC}"
if ! load_ssh_config "$CONFIG_FILE"; then
  log_output "${RED}✗ Failed to load SSH configuration${NC}"
  exit 1
fi

if ! load_nas_config "$CONFIG_FILE"; then
  log_output "${RED}✗ Failed to load NAS configuration${NC}"
  exit 1
fi

if ! load_smtp_config "$CONFIG_FILE"; then
  log_output "${RED}✗ Failed to load SMTP configuration${NC}"
  exit 1
fi

# Load email and domain configuration
ADMIN_EMAIL=$(get_config_value "$CONFIG_FILE" "email" "admin")
if [ -z "$ADMIN_EMAIL" ]; then
  log_output "${RED}✗ Failed to load admin email${NC}"
  exit 1
fi

BASE_DOMAIN=$(get_config_value "$CONFIG_FILE" "domain" "base")
if [ -z "$BASE_DOMAIN" ]; then
  log_output "${RED}✗ Failed to load base domain${NC}"
  exit 1
fi

log_output "${GREEN}✓ Configuration loaded${NC}\n"

# Step 1: Create cluster-config namespace
log_output "${YELLOW}Step 1: Creating cluster-config namespace${NC}"

namespace_manifest=$(cat <<EOF
apiVersion: v1
kind: Namespace
metadata:
  name: cluster-config
  labels:
    name: cluster-config
EOF
)

if ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "echo '$namespace_manifest' | sudo k3s kubectl apply -f -" 2>&1 > /dev/null; then
  log_output "${GREEN}✓ Namespace cluster-config created/updated${NC}\n"
else
  log_output "${YELLOW}⚠ Namespace may already exist (continuing)${NC}\n"
fi

# Step 2: Create ConfigMap with non-sensitive configuration
log_output "${YELLOW}Step 2: Creating cluster-config ConfigMap${NC}"

configmap_manifest=$(cat <<EOF
apiVersion: v1
kind: ConfigMap
metadata:
  name: cluster-config
  namespace: cluster-config
  labels:
    component: cluster-config
data:
  # Domain configuration
  BASE_DOMAIN: "$BASE_DOMAIN"

  # NAS configuration
  NAS_IP: "$NAS_IP"
  NAS_BASE_SHARE: "$NAS_BASE_SHARE"
  NAS_BASE_MOUNT: "$NAS_BASE_MOUNT"
  NAS_HOMELAB_PATH: "$NAS_BASE_MOUNT/homelab"
  NAS_BACKUPS_PATH: "$NAS_BASE_MOUNT/backups"
  NAS_IMMICH_PATH: "$NAS_BASE_MOUNT/immich"
  NAS_NEXTCLOUD_PATH: "$NAS_BASE_MOUNT/nextcloud"

  # SMTP configuration (non-sensitive parts)
  SMTP_SERVER: "$SMTP_SERVER"
  SMTP_PORT: "$SMTP_PORT"
  SMTP_FROM: "$SMTP_FROM"

  # Email configuration
  ADMIN_EMAIL: "$ADMIN_EMAIL"

  # Server configuration
  SERVER_IP: "$SERVER_IP"
EOF
)

if ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "echo '$configmap_manifest' | sudo k3s kubectl apply -f -" 2>&1 > /dev/null; then
  log_output "${GREEN}✓ ConfigMap cluster-config created/updated${NC}\n"
else
  log_output "${RED}✗ Failed to create ConfigMap${NC}"
  exit 1
fi

# Step 3: Create Secret with sensitive configuration
log_output "${YELLOW}Step 3: Creating cluster-config Secret${NC}"

secret_manifest=$(cat <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: cluster-config
  namespace: cluster-config
  labels:
    component: cluster-config
type: Opaque
stringData:
  SMTP_USERNAME: "$SMTP_USERNAME"
  SMTP_PASSWORD: "$SMTP_PASSWORD"
EOF
)

if ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "echo '$secret_manifest' | sudo k3s kubectl apply -f -" 2>&1 > /dev/null; then
  log_output "${GREEN}✓ Secret cluster-config created/updated${NC}\n"
else
  log_output "${RED}✗ Failed to create Secret${NC}"
  exit 1
fi

# Step 4: Verify ConfigMap and Secret
log_output "${YELLOW}Step 4: Verifying Configuration${NC}\n"

log_output "  ConfigMap contents:"
configmap_check=$(ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "sudo k3s kubectl get configmap cluster-config -n cluster-config -o yaml" 2>&1)

echo "$configmap_check" | tee -a "$LOG_FILE" | grep -E "^\s+(.*_.*):.*" | sed 's/^/    /'
log_output ""

log_output "  Secret keys:"
secret_check=$(ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "sudo k3s kubectl get secret cluster-config -n cluster-config -o yaml | grep -E '^\s+[A-Z_]+:'" 2>&1)

echo "$secret_check" | tee -a "$LOG_FILE" | sed 's/^/    /'
log_output ""

log_output "${GREEN}=== ✓ Cluster Configuration Complete ===${NC}\n"
log_output "${YELLOW}How to use in Kubernetes manifests:${NC}\n"

log_output "  ${BLUE}ConfigMap references:${NC}"
log_output "    \$(VARIABLE_NAME)"
log_output "    or"
log_output "    valueFrom:"
log_output "      configMapKeyRef:"
log_output "        name: cluster-config"
log_output "        key: VARIABLE_NAME\n"

log_output "  ${BLUE}Secret references:${NC}"
log_output "    valueFrom:"
log_output "      secretKeyRef:"
log_output "        name: cluster-config"
log_output "        key: SMTP_PASSWORD\n"

log_output "${BLUE}Verify with:${NC}"
log_output "  kubectl get configmap cluster-config -n cluster-config -o yaml"
log_output "  kubectl get secret cluster-config -n cluster-config -o yaml\n"
log_output "${BLUE}Log saved to: $LOG_FILE${NC}\n"
