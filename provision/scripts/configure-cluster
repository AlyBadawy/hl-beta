#!/bin/bash

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
LOG_FILE="$PROJECT_DIR/provision.log"

source "$(dirname "$SCRIPT_DIR")/lib/defaults.sh"
require_server_ip

SSH_TIMEOUT=5

log_output() { echo -e "$1" | tee -a "$LOG_FILE"; }

log_output "${BLUE}=== Cluster Configuration ===${NC}\n"

# Prompt for SMTP credentials (the only values not hardcoded)
while true; do
  read -p "$(echo -e "${YELLOW}Enter SMTP username:${NC} ")" SMTP_USERNAME
  SMTP_USERNAME="${SMTP_USERNAME// /}"
  [ -n "$SMTP_USERNAME" ] && break
  echo -e "${RED}✗ SMTP username cannot be empty${NC}"
done

while true; do
  read -s -p "$(echo -e "${YELLOW}Enter SMTP password:${NC} ")" SMTP_PASSWORD
  echo
  [ -n "$SMTP_PASSWORD" ] && break
  echo -e "${RED}✗ SMTP password cannot be empty${NC}"
done

log_output "${GREEN}✓ SMTP credentials captured${NC}\n"

# Step 1: Create cluster-config namespace
log_output "${YELLOW}Step 1: Creating cluster-config namespace${NC}"

namespace_manifest=$(cat <<EOF
apiVersion: v1
kind: Namespace
metadata:
  name: cluster-config
  labels:
    name: cluster-config
EOF
)

if ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "echo '$namespace_manifest' | sudo k3s kubectl apply -f -" > /dev/null 2>&1; then
  log_output "${GREEN}✓ Namespace cluster-config ready${NC}\n"
else
  log_output "${YELLOW}⚠ Namespace may already exist (continuing)${NC}\n"
fi

# Step 2: Create ConfigMap with non-sensitive configuration
log_output "${YELLOW}Step 2: Creating cluster-config ConfigMap${NC}"

configmap_manifest=$(cat <<EOF
apiVersion: v1
kind: ConfigMap
metadata:
  name: cluster-config
  namespace: cluster-config
  labels:
    component: cluster-config
data:
  BASE_DOMAIN: "$DOMAIN"
  NAS_IP: "$NAS_IP"
  NAS_BASE_SHARE: "$NAS_BASE_SHARE"
  NAS_BASE_MOUNT: "$NAS_BASE_MOUNT"
  NAS_HOMELAB_PATH: "$NAS_BASE_MOUNT/homelab"
  NAS_BACKUPS_PATH: "$NAS_BASE_MOUNT/backups"
  NAS_IMMICH_PATH: "$NAS_BASE_MOUNT/immich"
  NAS_NEXTCLOUD_PATH: "$NAS_BASE_MOUNT/nextcloud"
  SMTP_SERVER: "$SMTP_SERVER"
  SMTP_PORT: "$SMTP_PORT"
  SMTP_FROM: "$SMTP_FROM"
  ADMIN_EMAIL: "$ADMIN_EMAIL"
  SERVER_IP: "$SERVER_IP"
EOF
)

if ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "echo '$configmap_manifest' | sudo k3s kubectl apply -f -" > /dev/null 2>&1; then
  log_output "${GREEN}✓ ConfigMap cluster-config created/updated${NC}\n"
else
  log_output "${RED}✗ Failed to create ConfigMap${NC}"
  exit 1
fi

# Step 3: Create Secret with sensitive credentials
log_output "${YELLOW}Step 3: Creating cluster-config Secret${NC}"

secret_manifest=$(cat <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: cluster-config
  namespace: cluster-config
  labels:
    component: cluster-config
type: Opaque
stringData:
  SMTP_USERNAME: "$SMTP_USERNAME"
  SMTP_PASSWORD: "$SMTP_PASSWORD"
EOF
)

if ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "echo '$secret_manifest' | sudo k3s kubectl apply -f -" > /dev/null 2>&1; then
  log_output "${GREEN}✓ Secret cluster-config created/updated${NC}\n"
else
  log_output "${RED}✗ Failed to create Secret${NC}"
  exit 1
fi

# Step 4: Kernel tuning
log_output "${YELLOW}Step 4: Applying kernel tuning (inotify + vm.max_map_count)${NC}"

if ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "sudo tee /etc/sysctl.d/99-k8s-tuning.conf > /dev/null <<'SYSCTL'
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 512
vm.max_map_count = 262144
SYSCTL
sudo sysctl --system > /dev/null 2>&1"; then
  log_output "${GREEN}✓ Kernel tuning applied${NC}\n"
else
  log_output "${RED}✗ Failed to apply kernel tuning${NC}"
  exit 1
fi

# Step 5: Verify
log_output "${YELLOW}Step 5: Verifying Configuration${NC}\n"

log_output "  ConfigMap keys:"
ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "sudo k3s kubectl get configmap cluster-config -n cluster-config -o yaml" 2>&1 \
  | tee -a "$LOG_FILE" | grep -E "^\s+[A-Z_]+:" | sed 's/^/    /'

log_output ""
log_output "  Secret keys:"
ssh \
  -o ConnectTimeout=$SSH_TIMEOUT \
  -o StrictHostKeyChecking=no \
  -o UserKnownHostsFile=/dev/null \
  -o LogLevel=QUIET \
  "$SSH_USER@$SERVER_IP" \
  "sudo k3s kubectl get secret cluster-config -n cluster-config -o yaml | grep -E '^\s+[A-Z_]+:'" 2>&1 \
  | tee -a "$LOG_FILE" | sed 's/^/    /'

log_output ""
log_output "${GREEN}=== ✓ Cluster Configuration Complete ===${NC}\n"
